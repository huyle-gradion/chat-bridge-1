{
  "name": "chat-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf packages/*/dist packages/sources/*/dist packages/sinks/*/dist packages/*/*.tsbuildinfo",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "guard": "tsx guards/run-all.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
