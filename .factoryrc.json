{
  "$schema": "https://agentic-factory.dev/schema.json",
  "project": {
    "name": "chat-bridge",
    "architecture": "modular-monorepo"
  },
  "guards": {
    "noCycles": {
      "enabled": true,
      "rootDir": "packages"
    },
    "boundaries": [
      {
        "package": "packages/types",
        "disallowImportsFrom": [
          "packages/engine",
          "packages/sources",
          "packages/sinks",
          "packages/testing"
        ]
      },
      {
        "package": "packages/engine",
        "disallowImportsFrom": [
          "packages/sources",
          "packages/sinks"
        ]
      },
      {
        "package": "packages/sources",
        "disallowImportsFrom": [
          "packages/sinks"
        ]
      },
      {
        "package": "packages/sinks",
        "disallowImportsFrom": [
          "packages/sources"
        ]
      }
    ],
    "plainLanguage": {
      "enabled": true,
      "targetDirs": [
        "packages/ui",
        "packages/i18n",
        "packages/locales"
      ],
      "forbiddenTerms": [
        "sink",
        "outbox",
        "jid",
        "regex",
        "daemon",
        "payload",
        "stdout"
      ],
      "disallowEmDashes": true,
      "disallowEmojis": true
    },
    "secrets": {
      "enabled": true
    },
    "todoIssueLinks": {
      "enabled": true
    },
    "commentedCode": {
      "enabled": true
    },
    "deadExports": {
      "enabled": true,
      "rootDir": "packages"
    }
  },
  "testing": {
    "targetCoverage": 85,
    "maxSuiteDurationMs": 2000,
    "requireSyntheticScenarios": true
  },
  "agent": {
    "runner": "antigravity-cli",
    "model": "gemini-3.8-flash-high",
    "routes": [
      {
        "labels": [
          "chore",
          "docs"
        ],
        "model": "gemini-3.8-flash-high"
      }
    ],
    "context": [
      ".agents/rules/AGENTS.md",
      "docs/spec.md",
      "docs/decisions.md"
    ],
    "setup": "pnpm install --frozen-lockfile",
    "gates": [
      {
        "name": "build",
        "run": "pnpm build",
        "timeoutMs": 300000
      },
      {
        "name": "guard",
        "run": "pnpm guard",
        "timeoutMs": 300000
      },
      {
        "name": "test",
        "run": "pnpm test",
        "timeoutMs": 600000
      },
      {
        "name": "e2e",
        "run": "pnpm e2e:cli",
        "timeoutMs": 300000
      }
    ],
    "tdd": {
      "redGate": "test"
    },
    "protectedPaths": [
      "guards/**",
      "e2e/**",
      "bench/**",
      ".agents/**",
      "AGENTS.md",
      "spec-chat-bridge.md",
      "docs/spec.md",
      "docs/decisions.md",
      "docs/decisions/**",
      "docs/harness-log.md",
      "docs/budget.md",
      "vitest.config.ts",
      "tsconfig.base.json",
      "tsconfig.json",
      "pnpm-workspace.yaml",
      "docker/**"
    ],
    "sandbox": {
      "image": "chat-bridge-agent:1",
      "agent": true,
      "memory": "6g",
      "cpus": 4
    },
    "maxAttempts": 3,
    "sessionTimeoutMs": 1800000,
    "plan": {
      "approval": "required"
    },
    "review": {
      "when": "labelled",
      "labels": [
        "risky",
        "security"
      ],
      "maxFixRounds": 1
    },
    "budget": {
      "weeklyUsd": 160,
      "bugOnlyAt": 0.8,
      "stopAt": 1.0,
      "bugLabels": [
        "bug"
      ],
      "utcOffset": "+07:00",
      "pricing": {
        "gemini-4-argon-high": {
          "inputPerMTok": 2.0,
          "cachedInputPerMTok": 0.1,
          "outputPerMTok": 10.0
        },
        "gemini-3.8-flash-high": {
          "inputPerMTok": 0.75,
          "cachedInputPerMTok": 0.075,
          "outputPerMTok": 3.75
        },
        "gemini-3.8-flash-medium": {
          "inputPerMTok": 0.75,
          "cachedInputPerMTok": 0.075,
          "outputPerMTok": 3.75
        }
      }
    }
  }
}
